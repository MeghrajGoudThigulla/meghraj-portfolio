{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "API for portfolio contact submissions",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "operator:eval": "ts-node scripts/operator-eval.ts",
    "migrate": "prisma migrate deploy",
    "prestart": "prisma migrate deploy",
    "start": "node --dns-result-order=ipv4first dist/index.js",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "prisma": "7.10.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "vitest": "^4.0.18"
  }
}
