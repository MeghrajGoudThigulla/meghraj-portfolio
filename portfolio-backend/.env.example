# =====================================================================
# Portfolio Backend (Render / Production) Environment Variables
# =====================================================================

# 1. Server & Environment
NODE_ENV=production
PORT=4000
TRUST_PROXY=true

# 2. Database (Required)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 3. CORS Configuration (Required in production)
# Comma-separated origins allowed to make requests
CORS_ORIGINS=https://meghraj-portfolio.web.app,https://meghraj-portfolio.firebaseapp.com

# 4. Operator RAG V1 (NEW in Portfolio V2)
# Set to 'false' if you need to kill-switch /api/operator
OPERATOR_ENABLED=true
# (Recommended Primary) Groq API key (llama-3.3-70b-versatile, sub-200ms latency)
GROQ_API_KEY=gsk_your_groq_api_key_here
# (Optional Fallback) Gemini API key if Groq is not configured
# If both keys are omitted, the server falls back to deterministic extractive synthesis from corpus.json.
GEMINI_API_KEY=

# 5. Email & Contact Form (Resend)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=portfolio@yourdomain.com
ALERT_TO=your-email@outlook.com

# 6. Rate Limiting & Metrics Deduplication (Optional tunables)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
METRICS_DEDUPE_TTL_DAYS=45
METRICS_DEDUPE_CLEANUP_INTERVAL_HOURS=24

# 7. PostgreSQL TLS (Optional - only needed if DB requires custom CA cert)
# PG_CA_CERT=
# PG_CA_CERT_B64=
# PG_SSL_ALLOW_SELF_SIGNED=false
