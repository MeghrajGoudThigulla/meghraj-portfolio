{
  "name": "portfolio-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "find out -name '*.map' -type f -delete 2>/dev/null || true",
    "start": "next start",
    "lint": "eslint",
    "lint:copy": "node --experimental-strip-types scripts/lint-copy.ts",
    "smoke": "node --experimental-strip-types ../scripts/smoke-test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "firebase:login": "npx -y firebase-tools login",
    "deploy": "npm run build && npx -y firebase-tools deploy --only hosting",
    "deploy:preview": "npm run build && npx -y firebase-tools hosting:channel:deploy preview"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "firebase": "^13.0.0",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "next": "16.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5",
    "vitest": "^4.0.7",
    "vitest-axe": "^0.1.0"
  }
}
